<ui:FluentWindow x:Class="CharmChecker.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="アプリ情報" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="BIZ UDGothic" FontSize="14"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <!-- 色はPalette/Dark.xaml・Light.xamlで定義し、DynamicResourceで参照する -->
    <DockPanel>
        <ui:TitleBar DockPanel.Dock="Top" Title="アプリ情報" FontFamily="BIZ UDGothic" FontSize="16"
                     ShowMinimize="False" ShowMaximize="False" />

        <!-- 下部の帯: 使用ライブラリ -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource FooterBackground}"
                BorderBrush="{DynamicResource SplitterColor}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel TextElement.Foreground="{DynamicResource SecondaryText}">
                <TextBlock Text="使用ライブラリ" FontSize="13" Margin="0,0,0,4" />
                <TextBlock Text="OpenCvSharp4 4.13.0.20260602 / WPF-UI 4.3.0" FontSize="13" />
                <TextBlock Text="Windows.Media.Ocr（Windows 組み込み）" FontSize="13" />
                <TextBlock Text="ライセンス表示は同梱の THIRD-PARTY-NOTICES を参照してください。" FontSize="12"
                           Margin="0,6,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Margin="20,16,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Image Grid.Column="0" Source="app.ico" Width="48" Height="48"
                   VerticalAlignment="Top" Margin="0,2,16,0"
                   RenderOptions.BitmapScalingMode="HighQuality" />

            <StackPanel Grid.Column="1">
                <TextBlock Text="MHWilds 護石チェッカー" FontSize="22" Foreground="{DynamicResource AccentLine}" />
                <TextBlock x:Name="VersionText" Margin="0,6,0,0" />
                <TextBlock Text="モンスターハンターワイルズの護石読み取り・重複チェッカー"
                           TextWrapping="Wrap" />
                <TextBlock Text="Copyright (c) 2026 tsZ" Margin="0,14,0,0" />
                <TextBlock Text="MIT License" />
                <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="12"
                           Foreground="{DynamicResource SecondaryText}"
                           Text="本ツールはカプコンが権利を有する「モンスターハンターワイルズ」に関連する非公式のファンツールです。カプコンおよび同社の関連会社とは一切関係がありません。" />
            </StackPanel>

            <Button Grid.Row="1" Grid.Column="1" Content="閉じる" HorizontalAlignment="Right"
                    MinWidth="96" Padding="12,4" Margin="0,18,0,0"
                    IsDefault="True" IsCancel="True" Click="CloseButton_Click" />
        </Grid>
    </DockPanel>
</ui:FluentWindow>
