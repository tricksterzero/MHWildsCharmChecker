<ui:FluentWindow x:Class="CharmChecker.App.DuplicateCheckWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="重複チェック" Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        FontFamily="BIZ UDGothic" FontSize="16"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <DockPanel>
        <DockPanel.Resources>
            <SolidColorBrush x:Key="CardBackground" Color="#FF2A2A2A" />
            <SolidColorBrush x:Key="SecondaryText" Color="#FF9E9E9E" />
        </DockPanel.Resources>
        <ui:TitleBar DockPanel.Dock="Top" Title="重複チェック" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="16,0,16,12">
            <Button x:Name="SaveButton" Content="テキストファイルに保存" Padding="12,4"
                    Visibility="Collapsed" Click="Save_Click" />
        </StackPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock x:Name="DupCheckSummary" TextWrapping="Wrap" />

                <!-- 完全同一セクション -->
                <StackPanel x:Name="DupIdenticalSection" Visibility="Collapsed"
                            Margin="0,16,0,0">
                    <TextBlock Text="完全同一の護石" FontSize="16" FontWeight="Bold" />
                    <ItemsControl x:Name="DupIdenticalList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackground}"
                                        Padding="12,8" Margin="0,0,0,8"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Margin="12,4,0,0"
                                                   Foreground="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- 上位互換ありセクション -->
                <StackPanel x:Name="DupInferiorSection" Visibility="Collapsed"
                            Margin="0,16,0,0">
                    <TextBlock Text="上位互換がある護石" FontSize="16" FontWeight="Bold" />
                    <ItemsControl x:Name="DupInferiorList" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource CardBackground}"
                                        Padding="12,8" Margin="0,0,0,8"
                                        CornerRadius="4">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Header}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Margin="12,4,0,0"
                                                   Foreground="{StaticResource SecondaryText}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</ui:FluentWindow>
