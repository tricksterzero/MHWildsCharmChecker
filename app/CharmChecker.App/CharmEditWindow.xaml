<ui:FluentWindow x:Class="CharmChecker.App.CharmEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="護石の編集" Height="460" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        FontFamily="BIZ UDGothic" FontSize="16"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar Grid.Row="0" Title="護石の編集" FontFamily="BIZ UDGothic" FontSize="16" />
        <Grid Grid.Row="1" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- スキル -->
        <TextBlock Grid.Row="0" Text="スキル" FontWeight="Bold" Margin="0,0,0,4" />
        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Skill1Name" IsEditable="True" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Text="Lv" VerticalAlignment="Center" />
                    <ComboBox x:Name="Skill1Lv" Width="60" Margin="4,0,0,0">
                        <ComboBoxItem Content="0" />
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                    </ComboBox>
                </StackPanel>
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Skill2Name" IsEditable="True" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Text="Lv" VerticalAlignment="Center" />
                    <ComboBox x:Name="Skill2Lv" Width="60" Margin="4,0,0,0">
                        <ComboBoxItem Content="0" />
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                    </ComboBox>
                </StackPanel>
            </Grid>
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="Skill3Name" IsEditable="True" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0,0,0">
                    <TextBlock Text="Lv" VerticalAlignment="Center" />
                    <ComboBox x:Name="Skill3Lv" Width="60" Margin="4,0,0,0">
                        <ComboBoxItem Content="0" />
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" />
                        <ComboBoxItem Content="4" />
                    </ComboBox>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- スロット -->
        <TextBlock Grid.Row="2" Text="スロット" FontWeight="Bold" Margin="0,0,0,4" />
        <StackPanel Grid.Row="3" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Margin="0,2">
                <TextBlock Text="武器:" Width="40" VerticalAlignment="Center" />
                <ComboBox x:Name="WeaponSlot1" Width="60">
                    <ComboBoxItem Content="0" />
                    <ComboBoxItem Content="1" />
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,4">
                <TextBlock Text="防具:" Width="40" VerticalAlignment="Center" />
                <ComboBox x:Name="ArmorSlot1" Width="60">
                    <ComboBoxItem Content="0" />
                    <ComboBoxItem Content="1" />
                    <ComboBoxItem Content="2" />
                    <ComboBoxItem Content="3" />
                </ComboBox>
                <ComboBox x:Name="ArmorSlot2" Width="60" Margin="8,0,0,0">
                    <ComboBoxItem Content="0" />
                    <ComboBoxItem Content="1" />
                </ComboBox>
            </StackPanel>
        </StackPanel>

        <!-- レアリティ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="レアリティ:" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock x:Name="InferredRarityText" Text="-" Margin="8,0,0,0"
                       VerticalAlignment="Center" Foreground="#FF9E9E9E" />
        </StackPanel>

        <!-- ボタン -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Width="80" Padding="4" IsDefault="True"
                    Click="OkButton_Click" />
            <Button Content="キャンセル" Width="80" Margin="8,0,0,0" Padding="4"
                    IsCancel="True" />
        </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
