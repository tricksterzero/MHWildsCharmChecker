<!-- アプリ独自の色定義(ダーク)。Light.xamlと同じキーを持ち、ThemeServiceがテーマに応じて差し替える。
     各画面からはDynamicResourceで参照すること(StaticResourceだと実行中のテーマ切り替えに追従しない) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 詳細パネル・重複チェック結果のカード背景 -->
    <SolidColorBrush x:Key="CardBackground" Color="#FF2A2A2A" />
    <!-- アプリ情報の下部の帯 -->
    <SolidColorBrush x:Key="FooterBackground" Color="#FF2A2A2A" />
    <!-- 区切り線・グリッド線・GridSplitter -->
    <SolidColorBrush x:Key="SplitterColor" Color="#FF505050" />
    <!-- 補足的な文字(未選択のタブ・メニューボタン、注記) -->
    <SolidColorBrush x:Key="SecondaryText" Color="#FF9E9E9E" />
    <!-- 選択中のタブ・ホバー中のメニューボタンの文字 -->
    <SolidColorBrush x:Key="EmphasisText" Color="White" />
    <!-- タブ・メニューボタンのホバー背景 -->
    <SolidColorBrush x:Key="HoverBackground" Color="#20FFFFFF" />
    <!-- 選択中のタブの下線・アプリ情報のアプリ名 -->
    <SolidColorBrush x:Key="AccentLine" Color="#FF60CDFF" />
    <!-- 護石一覧(DataGrid) -->
    <SolidColorBrush x:Key="GridAlternatingRow" Color="#FF2A2A2A" />
    <SolidColorBrush x:Key="GridHeaderBackground" Color="#FF333333" />
    <SolidColorBrush x:Key="GridHeaderForeground" Color="#FFD0D0D0" />
    <SolidColorBrush x:Key="GridSelectedBackground" Color="#FF264F78" />
    <SolidColorBrush x:Key="GridSelectedForeground" Color="White" />
</ResourceDictionary>
